{
  "name": "Kallisto C++ Dev Environment",
  "image": "docker.io/thanhzeus2016/naughtian-kallisto-devcontainer:1.0.0",
  "customizations": {
    "vscode": {
      "extensions": [
		"ms-vscode.test-adapter-converter",
		"ms-python.python",
        "formulahendry.code-runner",
		"vadimcn.vscode-lldb",
		"serayuzgur.crates",
 	    "sonarsource.sonarlint-vscode",
        "google.gemini-cli-vscode-ide-companion",
		"google.geminicodeassist",
        "llvm-vs-code-extensions.vscode-clangd",
		"rust-lang.rust-analyzer",
	    "tamasfe.even-better-toml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "code-runner.runInTerminal": true,
        "editor.formatOnSave": true,
        "rust-analyzer.check.command": "clippy",
        "[cpp]": {
          "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
        },
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "RUSTUP_HOME": "/home/vscode/.rustup",
    "CARGO_HOME": "/home/vscode/.cargo"
  },
  "remoteEnv": {
    "RUSTUP_HOME": "/home/vscode/.rustup",
    "CARGO_HOME": "/home/vscode/.cargo",
    "PATH": "/home/vscode/.cargo/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /workspaces"
}